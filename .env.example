# Zryth voice agent (LiveKit worker + webhook_server.py). Runtime secrets ONLY.
# Customer numbers, agents and knowledge live in Supabase; nothing per-customer goes here.

# --- LiveKit ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Worker name the SIP dispatch rule routes calls to
AGENT_NAME=maya
# Outbound trunk used for warm transfers to a human (each agent's transfer_number)
LIVEKIT_SIP_OUTBOUND_TRUNK=
LIVEKIT_SIP_NUMBER=

# --- Speech (Sarvam) ---
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_VOICE=roopa

# --- LLM (Groq primary, Gemini fallback + embeddings + summaries) ---
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_REASONING_EFFORT=none
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.5-flash-lite
LLM_TEMPERATURE=0.3
MAX_TOKENS=300

# --- Supabase (secret key: bypasses RLS; reads numbers/agents, writes calls/messages) ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Shared with zryth-backend (AGENT_SHARED_SECRET); protects /internal/* on webhook_server.py
SUPABASE_WEBHOOK_SECRET=
# Re-chunk legacy knowledge rows: true on exactly ONE agent host
KB_AUTO_HEAL=false
# Full knowledge resync safety net (seconds), in case Realtime events are missed
KB_RESYNC_INTERVAL_S=600

# --- Default line (calls to numbers not in phone_numbers) ---
# Agent (agents.id) that answers numbers not in phone_numbers, e.g. console/dev calls
DEFAULT_ORG_AGENT_ID=
DEFAULT_LANGUAGE=en
DEFAULT_TRANSFER_NUMBER=

# --- Call feel / latency ---
VAD_MIN_SILENCE_MS=300
MIN_ENDPOINTING_DELAY=0.40
MAX_ENDPOINTING_DELAY=1.00
USER_AWAY_TIMEOUT_S=20

# --- Only for deploy/create_sip_trunk.py (one-time setup) ---
SIP_URI=
VOBIZ_DID=
